# ============================================================================
# LLM Provider Configuration
# ============================================================================

# LLM Provider: ollama, deepseek, google, or huggingface
LLM_PROVIDER=huggingface

# Ollama (local model runtime - optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=tinyllama

# DeepSeek API (optional)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Google Gemini API (optional)
GOOGLE_API_KEY=your_google_api_key_here

# HuggingFace Inference API (for Qwen2.5-72B-Instruct)
HUGGINGFACE_API_KEY="your_huggingface_api_key_here"
HUGGINGFACE_MODEL_ID=Qwen/Qwen2.5-72B-Instruct

# Model Configuration
MODEL_NAME=Qwen2.5-72B-Instruct
AGENT_TEMPERATURE=0.7

# ============================================================================
# Embeddings Configuration
# ============================================================================

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=models/embedding-001
ENABLE_MOCK_ON_QUOTA_ERROR=true

# ============================================================================
# Weaviate Vector Store Configuration
# ============================================================================

WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY="your_weaviate_api_key_here"

# ============================================================================
# PostgreSQL Configuration (LangGraph State Persistence)
# ============================================================================

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=synapse_user
POSTGRES_PASSWORD=synapse_password_123
POSTGRES_DB=synapse_ai

# ============================================================================
# Application Settings
# ============================================================================

VERBOSE=true
MAX_ITERATIONS=5
